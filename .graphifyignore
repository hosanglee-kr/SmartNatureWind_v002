# ==============================================================================
# .graphifyignore - Graphify Knowledge Graph Exclusion Rules
# SmartNatureWind_v002 (Active Target: src/v0200 Firmware & Contract Docs)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 구버전 펌웨어 소스 및 레거시 문서 (Old Firmware & Inactive Docs)
#    - 현재 활성 버전은 src/v0200 입니다. 구버전 소스 및 과거 문서를 제외하여
#      심볼/함수 중복 및 그래프 노드 오염을 방지합니다.
# ------------------------------------------------------------------------------
src/T2_Doc/              # 하드웨어 센서(LS2420 레이더 등) 테스트 및 과거 초안 문서
src/v014/                # 구버전 펌웨어 v014 소스
src/v015/                # 구버전 펌웨어 v015 소스
src/v016/                # 구버전 펌웨어 v016 소스
src/v017/                # 구버전 펌웨어 v017 소스
src/main.cpp.*           # main.cpp 백업 파일 (main.cpp.001, main.cpp.002 등)

# ------------------------------------------------------------------------------
# 2. 백업 디렉토리 및 임시 백업 파일 (Backup Directories & Files)
#    - 작업 중 생성된 백업 디렉토리와 확장자(.bak, .old, 순번 백업 등) 제외
# ------------------------------------------------------------------------------
src_backup/              # src 전체 백업 폴더
**/*_backup/             # 모든 하위 버전 백업 폴더 (v015_backup, v0200_backup 등)
**/*.bak                 # 백업 임시 파일
**/*.old                 # 이전 버전 임시 파일
**/*.001                 # 넘버링 백업 파일 (.001)
**/*.002                 # 넘버링 백업 파일 (.002)

# ------------------------------------------------------------------------------
# 3. 레거시/기획 문서 및 이미지 (Legacy Documentation, Plans & Media)
#    - 과거 버전 README, 기획 스케치 문서 및 이미지 에셋 제외 (README.md는 유지)
# ------------------------------------------------------------------------------
README_*.md              # 과거 버전 README 백업 (README_v0.0.3.kr.md 등)
!README.md               # 프로젝트 메인 README.md는 분석 대상에 포함
docs/                    # 제품 소개/데모 이미지(.png, .gif) 및 구버전 히스토리 문서
plan/                    # 초기 개발/기획 단계 마크다운 문서

# ------------------------------------------------------------------------------
# 4. v0200 내부 레거시/도구/웹 리소스 (v0200 Internal Legacy, Tools & Web Assets)
#    - v0170 참조 문서, 이전 웹 자산, 구버전 압축 스크립트 및 LittleFS 빌드 산출물
# ------------------------------------------------------------------------------
src/v0200/**/Ref/        # v0200 내부의 v0170 구버전 참조 문서/스크립트 (UserManual, Terminology 등)
src/v0200/data_src_v0200/ # 이전 v3 웹 UI 원본 소스
src/v0200/data_v0200/    # 이전 v3 웹 UI 정적 리소스 및 레거시 JSON
src/v0200/tools_0200/    # 이전 버전 빌드 도구 (현재는 tools_0201/pio_gzip_0201.py 사용)
src/v0200/data_v0201/html_v0201/ # LittleFS 배포용 웹 스테이징 디렉토리
**/*.gz                  # LittleFS 업로드용 Gzip 압축 바이너리 (.css.gz, .js.gz 등)

# ------------------------------------------------------------------------------
# 5. CI/CD, IDE 및 AI 에이전트 설정 (CI/CD, IDE & Agent Configurations)
#    - 빌드 파이프라인 YAML, 에디터 설정 및 에이전트 내부 스킬 문서 제외
# ------------------------------------------------------------------------------
.github/                 # GitHub Actions CI 워크플로우 YAML
.vscode/                 # VSCode 작업 환경 설정 JSON
.agents/                 # 프로젝트 로컬 에이전트 스킬 및 설정
.agent/skills/           # 에이전트 스킬 가이드 마크다운

# ------------------------------------------------------------------------------
# 6. 빌드 산출물 및 그래프 캐시 (Build Artifacts & Graphify Outputs)
#    - PlatformIO 빌드 결과물, 캐시, 컴파일 DB 및 Graphify 출력 폴더
# ------------------------------------------------------------------------------
.pio/                    # PlatformIO 컴파일 바이너리 및 라이브러리 캐시
.cache/                  # 컴파일러/빌드 캐시
compile_commands.json    # Clang 컴파일 데이터베이스 (pio run -t compiledb 생성물)
graphify-out/            # Graphify 지식 그래프 산출물 및 임시 캐시
